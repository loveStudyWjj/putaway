# 复制为 keystore.properties 后填写（该文件已在 .gitignore，切勿提交真实文件）
# 生成 keystore：
#   keytool -genkey -v -keystore wugui.keystore -alias wugui -keyalg RSA -keysize 2048 -validity 10000
# storeFile 相对 android/ 目录，或用绝对路径
storeFile=wugui.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=wugui
keyPassword=YOUR_KEY_PASSWORD
